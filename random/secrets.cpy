# @std/random — Python `secrets`-style helpers on top of the OS CSPRNG.
#
# Every value returned by this module is generated by the platform's
# cryptographic random number generator. Use these helpers for tokens,
# session identifiers, verification codes and keys — never use the `prng`
# module for those purposes.

import "csprng.cpy"

# Fresh cryptographic bytes as a Cpyte array.
public def token_bytes(n int64) -> char[]:
    return bytes(n)

# Lowercase hexadecimal token: two ASCII chars per byte, NUL terminated.
public def token_hex(n int64) -> char[]:
    char[] raw = bytes(n)
    return hex((void*)raw, (size_t)n)

# Unpadded base64url token (RFC 4648), NUL terminated.
public def token_urlsafe(n int64) -> char[]:
    char[] raw = bytes(n)
    return b64url((void*)raw, (size_t)n)

# RFC 4122 version-4 UUID, 36 ASCII chars + NUL.
public def token_uuid4() -> char[]:
    return uuid4()

# Uniform integer in [0, bound), rejection-sampled without modulo bias.
public def randbelow(bound uint64) -> uint64:
    return below(bound)

# Uniform integer in [lo, hi], inclusive.
public def randint(lo int64, hi int64) -> int64:
    return int_range(lo, hi)

# Constant-time comparison of `n` bytes. Returns 1 when equal, 0 otherwise.
public def compare_digest(a void*, b void*, n size_t) -> int:
    return ct_equal(a, b, n)
